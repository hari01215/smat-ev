# ========================================================
# SMART EV CHARGING PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase PostgreSQL & Auth (Optional - platform automatically uses resilient fallback store when unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Open Charge Map Official API (Optional - required for live global queries beyond benchmark stations)
OPEN_CHARGE_MAP_API_KEY=your_open_charge_map_api_key

# OCPI Roaming Integration (Optional - standard eMSP/CPO roaming)
OCPI_BASE_URL=https://ocpi.example-cpo.com/cpo/versions/2.2
OCPI_TOKEN=your_ocpi_token_here
OCPI_PARTY_ID=MSP
OCPI_COUNTRY_CODE=US

# OCPP IoT Telemetry Gateway (Optional - live hardware WebSockets)
OCPP_GATEWAY_URL=wss://ocpp-gateway.smartev.internal/v16
